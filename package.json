{
	"name": "spacey-capitalise",
	"displayName": "Spacey Capitalise",
	"description": "Capitalise and add spaces after each letter in the selected text",
	"publisher": "daniel-pate",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.41.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"*"
	],
	"main": "./extension.js",
	"scripts": {
		"test": "node ./test/runTest.js",
		"test:unit": "mocha --ui tdd test/unit"
	},
	"contributes": {
		"commands": [
			{
				"command": "extension.spaceyCapitalise",
				"title": "Spacey Capitalise"
			}
		]
	},
	"devDependencies": {
		"@types/mocha": "^5.2.7",
		"@types/node": "^12.11.7",
		"@types/vscode": "^1.41.0",
		"@vscode/test-electron": "^3.1.0",
		"eslint": "^10.14.0",
		"glob": "^14.0.3",
		"mocha": "^12.0.3",
		"typescript": "^3.6.4"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/greatpate/spacey-capitalise.git"
	},
	"overrides": {
		"minimatch": "^11.0.4",
		"glob": "^14.0.3"
	}
}
